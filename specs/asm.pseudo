/////////////////////////////////////////////////////////
//                                                     //
//  Symp v0.x (Pseudocode)                             //
//                                                     //
//  A mutable virtual filesystem where programs, data, //
//  references, and directories all live as symbolic   //
//  nodes.                                             //
//                                                     //
/////////////////////////////////////////////////////////

// Data structures

Expr        : Literal | List | Var | Asm | Call
Literal     : string | number | boolean
List        : {kind: "LIST", args: Expr[]}
Var         : {kind: "VAR", name: string}

Asm         : {kind: "ASM", args: string[], vars: string[], instrs: Instr[], dir: Dir}
Instr       : Lbl | Call | Asgn | Jne | Jeq | Jmp | Ret
Lbl         : {kind: "LABEL", label: string}
Asgn        : {kind: "ASGN", var: Var, value: Expr}
Jne         : {kind: "JMPNE", e1: Expr, e2: Expr, label: string}
Jeq         : {kind: "JMPEQ", e1: Expr, e2: Expr, label: string}
Jmp         : {kind: "JMP", label: string}
Call        : {kind: "CALL", type: "STMT" | "EXPR", calling: Var | Call | Asm, args: Expr[]}
Ret         : {kind: "RETURN", value: Expr}

File        : Data | Link
Dir         : {kind: "DIR", name: string, items: Map<string, File | Dir>}
Data        : {kind: "FILE", value: string}
Link        : {kind: "LINK", path: string}

// Code implementation

function run(prog: Asm, args: Expr[], root: Dir): Expr
    if prog.args.length != args.length
        Error(`Arity mismatch`)
    
    env = {}
    for i = 0 to prog.args.length - 1
        env[prog.args[i]] = args[i]
    
    for i = 0 to prog.vars.length - 1
        env[prog.vars[i]] = undefined
    
    labels = {}
    for idx = 0 to prog.instrs.length - 1
        if prog.instrs[idx].kind == "LABEL"
            labels[prog.instrs[idx].label] = idx
    
    idx = 0
    ctx = {env: env, root: root, dir: prog.dir}
    while idx < prog.instrs.length
        instr = prog.instrs[idx]
        if instr.kind == "CALL"
            evalCall(instr, ctx)
        
        else if instr.kind ==  "RETURN"
            if instr.value == undefined
                return undefined
            
            return evalExpr(instr.value, ctx)
                
        else if instr.kind == "ASGN"
            env[instr.var.name] = evalExpr(instr.value, ctx)
        
        else if instr.kind == "JMPNE" or instr.kind == "JMPEQ"
            e1 = evalExpr(instr.e1, ctx)
            e2 = evalExpr(instr.e2, ctx)
            if e1 is not Literal or e2 is not Literal
                Error(`Compared values not reduced to literals`)
            
            if instr.label not in labels
                Error(`Nonexisting label: ${instr.label}`)

            if (instr.kind == "JMPNE") == (e1 != e2)
                idx = labels[instr.label]
            
        else if instr.kind ==  "JMP"
            if instr.label not in labels
                Error(`Nonexisting label: ${instr.label}`)
            
            idx = labels[instr.label]
        
        idx += 1

    return undefined

function evalExpr(expr: Expr, ctx: {env: {}, root: Dir, dir: Dir}): Expr
    if expr.kind == "VAR"
        return evalVar(expr, ctx)
    
    else if expr.kind == "LIST"
        return evalList(expr, ctx)
        
    else if expr.kind == "CALL"
        return evalCall(expr, ctx)

    return expr

function evalVar(expr: Expr, ctx: {env: {}, root: Dir, dir: Dir}): Expr
    if expr.name in ctx.env
        if ctx.env[expr.name] == undefined
            Error(`Variable accessed before assignment: ${expr.name}`)
        
        return ctx.env[expr.name]
    
    else if expr.name in BUILTINS
        return BUILTINS[expr.name]
    
    Error(`Undeclared variable: ${expr.name}`)
    
function evalList(expr: Expr, ctx: {env: {}, root: Dir, dir: Dir}): Expr
    return {kind: "LIST", args: expr.args.map(e => evalExpr(e, ctx)};
        
function evalCall(expr: Expr, ctx: {env: {}, root: Dir, dir: Dir}): Expr
    fn = evalExpr(expr.calling, ctx)
    args = expr.args.map(e => evalExpr(e, ctx))
    if fn.kind == "ASM"
        result = run(fn, args, ctx.root)

    else if fn.kind == "NATIVE"
        result = fn.apply(args, ctx.root, ctx.dir)

    else
        Error(`Expression not callable`)
    
    if expr.type == "EXPR" and result == undefined
        Error(`Function returned undefined result`)
    
    return result

